package com.company.sftputility.config;

import com.company.sftputility.exception.ConfigurationException;

import java.io.FileInputStream;
import java.io.InputStream;
import java.util.Properties;

public class ApplicationConfig {

    private final Properties properties;

    public ApplicationConfig(String filePath) throws ConfigurationException {
        try {
            properties = new Properties();

            InputStream inputStream = new FileInputStream(filePath);
            properties.load(inputStream);
            inputStream.close();

        } catch (Exception e) {
            throw new ConfigurationException(
                    "Unable to load application configuration: " + filePath,
                    e
            );
        }
    }

    public String getApplicationName() throws ConfigurationException {
        return getRequiredProperty("application.name");
    }

    public String getApplicationVersion() throws ConfigurationException {
        return getRequiredProperty("application.version");
    }

    public String getDestinationConfigFile() throws ConfigurationException {
        return getRequiredProperty("destination.config.file");
    }

    public String getInputDirectory() throws ConfigurationException {
        return getRequiredProperty("input.directory");
    }

    public String getReportDirectory() throws ConfigurationException {
        return getRequiredProperty("report.directory");
    }

    public String getLogDirectory() throws ConfigurationException {
        return getRequiredProperty("log.directory");
    }

    public int getSftpConnectionTimeout() throws ConfigurationException {
        return getIntegerProperty("sftp.connection.timeout");
    }

    public int getSftpChannelTimeout() throws ConfigurationException {
        return getIntegerProperty("sftp.channel.timeout");
    }

    public boolean isRetryEnabled() throws ConfigurationException {
        return getBooleanProperty("sftp.retry.enabled");
    }

    public int getMaxRetryAttempts() throws ConfigurationException {
        return getIntegerProperty("sftp.retry.max-attempts");
    }

    private String getRequiredProperty(String key)
            throws ConfigurationException {

        try {
            String value = properties.getProperty(key);

            if (value == null || value.trim().isEmpty()) {
                throw new ConfigurationException(
                        "Required configuration property is missing: " + key
                );
            }

            return value.trim();

        } catch (ConfigurationException e) {
            throw e;

        } catch (Exception e) {
            throw new ConfigurationException(
                    "Error reading configuration property: " + key,
                    e
            );
        }
    }

    private int getIntegerProperty(String key)
            throws ConfigurationException {

        try {
            String value = getRequiredProperty(key);

            return Integer.parseInt(value);

        } catch (NumberFormatException e) {
            throw new ConfigurationException(
                    "Invalid integer value for property: " + key,
                    e
            );

        } catch (ConfigurationException e) {
            throw e;

        } catch (Exception e) {
            throw new ConfigurationException(
                    "Error reading integer property: " + key,
                    e
            );
        }
    }

    private boolean getBooleanProperty(String key)
            throws ConfigurationException {

        try {
            String value = getRequiredProperty(key);

            if (!"true".equalsIgnoreCase(value)
                    && !"false".equalsIgnoreCase(value)) {

                throw new ConfigurationException(
                        "Invalid boolean value for property: " + key
                );
            }

            return Boolean.parseBoolean(value);

        } catch (ConfigurationException e) {
            throw e;

        } catch (Exception e) {
            throw new ConfigurationException(
                    "Error reading boolean property: " + key,
                    e
            );
        }
    }
}







package com.company.sftputility;

import com.company.sftputility.config.ApplicationConfig;
import com.company.sftputility.exception.ConfigurationException;
import com.company.sftputility.model.Destination;
import com.company.sftputility.repository.DestinationRepository;
import com.company.sftputility.repository.JsonDestinationRepository;

public class SftpApplication {

    public static void main(String[] args) {

        try {

            System.out.println("=================================");
            System.out.println("       SFTP Utility Starting");
            System.out.println("=================================");

            // Load application configuration
            ApplicationConfig config =
                    new ApplicationConfig(
                            "config/application.properties"
                    );

            System.out.println(
                    "Application : " + config.getApplicationName()
            );

            System.out.println(
                    "Version     : " + config.getApplicationVersion()
            );

            // Get destination configuration file from properties
            String destinationConfigFile =
                    config.getDestinationConfigFile();

            System.out.println(
                    "Destination config : " + destinationConfigFile
            );

            // Load destinations
            DestinationRepository repository =
                    new JsonDestinationRepository(
                            destinationConfigFile
                    );

            // Test destination lookup
            Destination destination =
                    repository.findById("AB123");

            System.out.println();
            System.out.println("Destination loaded successfully.");
            System.out.println("ID   : " + destination.getId());
            System.out.println("Name : " + destination.getName());
            System.out.println("Host : " + destination.getHost());
            System.out.println("Port : " + destination.getPort());
            System.out.println("User : " + destination.getUsername());
            System.out.println("Dir  : " +
                    destination.getDestinationDirectory());

            System.out.println();
            System.out.println("Configuration loaded successfully.");

        } catch (ConfigurationException e) {

            System.err.println(
                    "Configuration error: " + e.getMessage()
            );

            e.printStackTrace();

        } catch (Exception e) {

            System.err.println(
                    "Unexpected application error."
            );

            e.printStackTrace();
        }
    }
}