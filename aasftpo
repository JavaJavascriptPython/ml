package com.company.sftputility.validation;

import com.company.sftputility.exception.ValidationException;
import com.company.sftputility.model.TransferRequest;

import java.io.File;

public class TransferValidator {

    public void validate(TransferRequest request)
            throws ValidationException {

        try {

            if (request == null) {
                throw new ValidationException(
                        "Transfer request cannot be null."
                );
            }

            // Transfer ID
            if (isEmpty(request.getTransferId())) {
                throw new ValidationException(
                        "Transfer ID cannot be empty."
                );
            }

            // Destination ID
            if (isEmpty(request.getDestinationId())) {
                throw new ValidationException(
                        "Destination ID cannot be empty."
                );
            }

            // Source file
            if (isEmpty(request.getSourceFile())) {
                throw new ValidationException(
                        "Source file cannot be empty."
                );
            }

            // Destination file
            if (isEmpty(request.getDestinationFile())) {
                throw new ValidationException(
                        "Destination file cannot be empty."
                );
            }

            // Source file must exist
            File sourceFile =
                    new File(request.getSourceFile());

            if (!sourceFile.exists()) {
                throw new ValidationException(
                        "Source file does not exist: "
                                + request.getSourceFile()
                );
            }

            if (!sourceFile.isFile()) {
                throw new ValidationException(
                        "Source path is not a regular file: "
                                + request.getSourceFile()
                );
            }

        } catch (ValidationException e) {

            throw e;

        } catch (Exception e) {

            throw new ValidationException(
                    "Unexpected error while validating transfer: "
                            + request.getTransferId(),
                    e
            );
        }
    }

    private boolean isEmpty(String value) {
        return value == null || value.trim().isEmpty();
    }
}