
import { Component } from '@angular/core';
import { Router } from '@angular/router';

import { AuthService } from '../../services/auth.service';

@Component({
  selector: 'app-layout',
  templateUrl: './layout.component.html',
  styleUrls: ['./layout.component.css']
})
export class LayoutComponent {

  currentUser$ = this.authService.currentUser$;

  logoutLoading = false;

  constructor(
    private authService: AuthService,
    private router: Router
  ) {}

  logout(): void {

    this.logoutLoading = true;

    this.authService.logout().subscribe(

      () => {
        this.logoutLoading = false;
        this.router.navigate(['/login']);
      },

      error => {
        this.logoutLoading = false;
        console.error('Logout failed:', error);
      }
    );
  }
}








<div class="app-layout">

  <header class="app-header">

    <div class="logo">
      My Application
    </div>

    <div class="header-right">

      <span *ngIf="currentUser$ | async as user">
        Welcome, {{ user.username }}
      </span>

      <button
        (click)="logout()"
        [disabled]="logoutLoading">

        {{ logoutLoading ? 'Logging out...' : 'Logout' }}

      </button>

    </div>

  </header>

  <div class="app-body">

    <aside class="sidebar">

      <nav>
        <a routerLink="/dashboard" routerLinkActive="active">
          Dashboard
        </a>
      </nav>

    </aside>

    <main class="main-content">

      <router-outlet></router-outlet>

    </main>

  </div>

</div>





.app-layout {
  min-height: 100vh;
  background: #f4f6fa;
}

.app-header {
  height: 60px;
  background: #ffffff;
  border-bottom: 1px solid #e5e7eb;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 25px;
}

.logo {
  font-size: 20px;
  font-weight: 700;
  color: #2457a6;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.header-right button {
  padding: 9px 18px;
  background: #2457a6;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

.header-right button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.app-body {
  display: flex;
  min-height: calc(100vh - 60px);
}

.sidebar {
  width: 220px;
  background: #ffffff;
  border-right: 1px solid #e5e7eb;
  padding: 20px;
  box-sizing: border-box;
}

.sidebar a {
  display: block;
  padding: 12px;
  color: #444;
  text-decoration: none;
  border-radius: 5px;
}

.sidebar a.active {
  background: #eaf0fb;
  color: #2457a6;
  font-weight: 600;
}

.main-content {
  flex: 1;
  padding: 30px;
}





<div class="dashboard">

  <h1>Dashboard</h1>

  <p class="subtitle">
    Welcome to your application. Here's your overview.
  </p>

  <div class="dashboard-cards">

    <div class="dashboard-card">
      <h3>Application Status</h3>
      <p class="status">Active</p>
    </div>

    <div class="dashboard-card">
      <h3>Authentication</h3>
      <p class="status">Authenticated</p>
    </div>

    <div class="dashboard-card">
      <h3>Session</h3>
      <p class="status">Connected</p>
    </div>

  </div>

</div>





.dashboard h1 {
  color: #263445;
  margin-bottom: 8px;
}

.subtitle {
  color: #777;
  margin-bottom: 30px;
}

.dashboard-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.dashboard-card {
  background: #ffffff;
  padding: 25px;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
}

.dashboard-card h3 {
  color: #555;
  font-size: 15px;
}

.status {
  color: #16834a;
  font-weight: 600;
  font-size: 18px;
}




