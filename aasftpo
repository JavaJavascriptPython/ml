package com.company.sftputility.sftp;

import com.company.sftputility.exception.SftpConnectionException;
import com.company.sftputility.exception.SftpTransferException;
import com.company.sftputility.model.Destination;
import com.jcraft.jsch.ChannelSftp;
import com.jcraft.jsch.JSch;
import com.jcraft.jsch.Session;

public class JschSftpService implements SftpService {

    private final int connectionTimeout;
    private final int channelTimeout;

    public JschSftpService(
            int connectionTimeout,
            int channelTimeout) {

        this.connectionTimeout = connectionTimeout;
        this.channelTimeout = channelTimeout;
    }

    @Override
    public void upload(
            Destination destination,
            String sourceFile,
            String destinationFile)
            throws SftpConnectionException,
                   SftpTransferException {

        Session session = null;
        ChannelSftp channel = null;

        try {

            /*
             * Step 1:
             * Create JSch instance.
             */
            JSch jsch = new JSch();

            /*
             * Step 2:
             * Create SSH session.
             */
            session = jsch.getSession(
                    destination.getUsername(),
                    destination.getHost(),
                    destination.getPort()
            );

            /*
             * Step 3:
             * Set password.
             *
             * IMPORTANT:
             * Never log this password.
             */
            session.setPassword(
                    destination.getEncryptedPassword()
            );

            /*
             * Step 4:
             * Host key verification.
             *
             * For initial development/testing we are
             * temporarily disabling strict verification.
             *
             * DO NOT keep this setting in production.
             */
            session.setConfig(
                    "StrictHostKeyChecking",
                    "no"
            );

            /*
             * Step 5:
             * Connection timeout.
             */
            session.connect(connectionTimeout);

            /*
             * Step 6:
             * Open SFTP channel.
             */
            channel = (ChannelSftp)
                    session.openChannel("sftp");

            /*
             * Step 7:
             * Channel timeout.
             */
            channel.connect(channelTimeout);

            /*
             * Step 8:
             * Upload.
             */
            channel.put(
                    sourceFile,
                    destinationFile
            );

        } catch (com.jcraft.jsch.JSchException e) {

            throw new SftpConnectionException(
                    "Unable to connect to SFTP destination: "
                            + destination.getId(),
                    e
            );

        } catch (com.jcraft.jsch.SftpException e) {

            throw new SftpTransferException(
                    "SFTP transfer failed for destination: "
                            + destination.getId(),
                    e
            );

        } catch (Exception e) {

            throw new SftpTransferException(
                    "Unexpected SFTP error for destination: "
                            + destination.getId(),
                    e
            );

        } finally {

            /*
             * Always disconnect.
             */
            if (channel != null) {

                try {
                    if (channel.isConnected()) {
                        channel.disconnect();
                    }
                } catch (Exception e) {
                    // Do not hide the original transfer exception.
                    e.printStackTrace();
                }
            }

            if (session != null) {

                try {
                    if (session.isConnected()) {
                        session.disconnect();
                    }
                } catch (Exception e) {
                    // Do not hide the original transfer exception.
                    e.printStackTrace();
                }
            }
        }
    }
}





package com.company.sftputility;

import com.company.sftputility.exception.SftpConnectionException;
import com.company.sftputility.exception.SftpTransferException;
import com.company.sftputility.model.Destination;
import com.company.sftputility.sftp.JschSftpService;
import com.company.sftputility.sftp.SftpService;

public class SftpServiceTest {

    public static void main(String[] args) {

        try {

            Destination destination =
                    new Destination();

            destination.setId("AB123");
            destination.setHost("YOUR_TEST_SERVER");
            destination.setPort(22);
            destination.setUsername("YOUR_TEST_USER");

            /*
             * Temporary testing only.
             *
             * Do not use a production password here.
             */
            destination.setEncryptedPassword(
                    "YOUR_TEST_PASSWORD"
            );

            destination.setDestinationDirectory(
                    "/incoming"
            );

            SftpService sftpService =
                    new JschSftpService(
                            30000,
                            30000
                    );

            sftpService.upload(
                    destination,
                    "input/test.txt",
                    "/incoming/test.txt"
            );

            System.out.println(
                    "SFTP upload successful."
            );

        } catch (SftpConnectionException e) {

            System.err.println(
                    "SFTP connection failed: "
                            + e.getMessage()
            );

            e.printStackTrace();

        } catch (SftpTransferException e) {

            System.err.println(
                    "SFTP transfer failed: "
                            + e.getMessage()
            );

            e.printStackTrace();

        } catch (Exception e) {

            System.err.println(
                    "Unexpected error."
            );

            e.printStackTrace();
        }
    }
}