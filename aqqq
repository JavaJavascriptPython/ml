<div class="toolbar">
  <h2>Entries</h2>
  <button class="btn btn-primary" (click)="add()">+ Add entry</button>
</div>

<div class="card">
  <table>
    <tr>
      <th>Name</th><th>Branch</th><th>IP</th><th>Homedir</th><th>Chdir</th>
      <th>Available</th><th>Sendvia</th><th>Mode</th><th>Actions</th>
    </tr>
    <tr *ngFor="let e of entries">
      <td>{{e.name}}</td><td>{{e.branchCode}}</td><td>{{e.ip}}</td>
      <td>{{e.homedir}}</td><td>{{e.chdir}}</td>
      <td><span class="badge" [class.badge-yes]="e.available==='Yes'"
                [class.badge-no]="e.available==='No'">{{e.available}}</span></td>
      <td>{{e.sendvia}}</td><td>{{e.mode}}</td>
      <td>
        <button class="btn btn-sm" (click)="edit(e)">Edit</button>
        <button class="btn btn-sm" (click)="logs(e)">Logs</button>
        <button class="btn btn-sm btn-danger" (click)="remove(e)">Delete</button>
      </td>
    </tr>
    <tr *ngIf="entries.length === 0"><td colspan="9" class="empty">No entries yet</td></tr>
  </table>
</div>

<div class="modal-backdrop" *ngIf="showForm">
  <div class="modal-box">
    <app-entry-form [entry]="selected"
                    (saved)="onSaved()" (cancelled)="showForm=false">
    </app-entry-form>
  </div>
