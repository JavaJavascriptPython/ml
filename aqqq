Style .modal-backdrop as a fixed full-screen dark overlay and .modal-box as a centered white box. That avoids adding a UI library that might not match Angular 6.
Changes to the form component (from the last message)
Add @Input() entry: Entry;, @Output() saved = new EventEmitter(); and @Output() cancelled = new EventEmitter();.
In ngOnInit, drop the route logic. If entry is set, patchValue it but leave password blank, and make password required only in add mode.
In save(), call update(this.entry.id, ...) if entry is set, otherwise create(...), then this.saved.emit().
Add a Cancel button that emits cancelled.
entry.service.ts needs getAll, create, update(id, e) and delete(id). The UI has no per-entry page, but the API still needs the id for edit and delete (PUT and DELETE /api/entries/{id}).
Logs design (this matters more on the backend)
One entry_log table, and the backend writes it automatically in the service layer whenever an entry is created, updated or deleted. The frontend never writes logs, so they can't be skipped or faked.




import { Injectable } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Observable } from 'rxjs';
import { Entry } from '../models/entry.model';

@Injectable({ providedIn: 'root' })
export class EntryService {
  private base = '/api/entries';

  constructor(private http: HttpClient) {}

  getAll(): Observable<Entry[]> {
    return this.http.get<Entry[]>(this.base);
  }
  create(entry: Entry): Observable<Entry> {
    return this.http.post<Entry>(this.base, entry);
  }
  update(id: number, entry: Entry): Observable<Entry> {
    return this.http.put<Entry>(this.base + '/' + id, entry);
  }
  delete(id: number): Observable<void> {
    return this.http.delete<void>(this.base + '/' + id);
  }
}




import { Component, EventEmitter, Input, OnInit, Output } from '@angular/core';
import { FormBuilder, FormGroup, Validators } from '@angular/forms';
import { Entry } from '../../core/models/entry.model';
import { EntryService } from '../../core/services/entry.service';

@Component({
  selector: 'app-entry-form',
  templateUrl: './entry-form.component.html',
  styleUrls: ['./entry-form.component.css']
})
export class EntryFormComponent implements OnInit {
  @Input() entry: Entry;                       // set = edit mode
  @Output() saved = new EventEmitter<void>();
  @Output() cancelled = new EventEmitter<void>();

  form: FormGroup;
  error = '';
  saving = false;

  // placeholders: replace with your real values
  availableOpts = ['Yes', 'No'];
  sendviaOpts = ['SFTP', 'FTP', 'SCP'];
  modeOpts = ['Push', 'Pull'];

  constructor(private fb: FormBuilder, private svc: EntryService) {}

  get isEdit(): boolean { return !!(this.entry && this.entry.id); }

  ngOnInit() {
    const alnum = Validators.pattern(/^[a-zA-Z0-9]+$/);
    const ip = Validators.pattern(
      /^((25[0-5]|2[0-4]\d|1?\d?\d)\.){3}(25[0-5]|2[0-4]\d|1?\d?\d)$/);

    this.form = this.fb.group({
      name:       ['', [Validators.required, alnum]],
      branchCode: ['', [Validators.required, alnum]],
      ip:         ['', [Validators.required, ip]],
      password:   ['', this.isEdit ? [] : [Validators.required]],
      homedir:    ['', Validators.required],
      chdir:      ['', Validators.required],
      available:  ['', Validators.required],
      sendvia:    ['', Validators.required],
      mode:       ['', Validators.required]
    });

    if (this.isEdit) {
      this.form.patchValue({ ...this.entry, password: '' });
    }
  }

  isInvalid(field: string): boolean {
    const c = this.form.get(field);
    return c.invalid && (c.dirty || c.touched);
  }

  save() {
    if (this.form.invalid) {
      Object.keys(this.form.controls).forEach(k => this.form.get(k).markAsTouched());
      return;
    }
    this.saving = true;
    this.error = '';

    const value = { ...this.form.value };
    if (this.isEdit && !value.password) {
      delete value.password;                   // blank = keep existing password
    }

    const call = this.isEdit
      ? this.svc.update(this.entry.id, value)
      : this.svc.create(value);

    call.subscribe(
      () => { this.saving = false; this.saved.emit(); },
      err => {
        this.saving = false;
        this.error = (err.error && err.error.message) || 'Save failed';
      }
    );
  }
}



<h3>{{ isEdit ? 'Edit entry' : 'Add entry' }}</h3>

<form [formGroup]="form" (ngSubmit)="save()" novalidate>
  <div class="grid">
    <div class="field">
      <label>Name</label>
      <input formControlName="name" [class.invalid]="isInvalid('name')">
      <small *ngIf="isInvalid('name')">Required, letters and digits only</small>
    </div>

    <div class="field">
      <label>Branch code</label>
      <input formControlName="branchCode" [class.invalid]="isInvalid('branchCode')">
      <small *ngIf="isInvalid('branchCode')">Required, letters and digits only</small>
    </div>

    <div class="field">
      <label>IP</label>
      <input formControlName="ip" [class.invalid]="isInvalid('ip')">
      <small *ngIf="isInvalid('ip')">Enter a valid IPv4 address</small>
    </div>

    <div class="field">
      <label>Password</label>
      <input type="password" formControlName="password" autocomplete="new-password"
             [placeholder]="isEdit ? 'Leave blank to keep current' : ''"
             [class.invalid]="isInvalid('password')">
      <small *ngIf="isInvalid('password')">Required</small>
    </div>

    <div class="field">
      <label>Home dir</label>
      <input formControlName="homedir" [class.invalid]="isInvalid('homedir')">
      <small *ngIf="isInvalid('homedir')">Required</small>
    </div>

    <div class="field">
      <label>Chdir</label>
      <input formControlName="chdir" [class.invalid]="isInvalid('chdir')">
      <small *ngIf="isInvalid('chdir')">Required</small>
    </div>

    <div class="field">
      <label>Available</label>
      <select formControlName="available" [class.invalid]="isInvalid('available')">
        <option value="">-- select --</option>
        <option *ngFor="let o of availableOpts" [value]="o">{{o}}</option>
      </select>
    </div>

    <div class="field">
      <label>Send via</label>
      <select formControlName="sendvia" [class.invalid]="isInvalid('sendvia')">
        <option value="">-- select --</option>
        <option *ngFor="let o of sendviaOpts" [value]="o">{{o}}</option>
      </select>
    </div>

    <div class="field">
      <label>Mode</label>
      <select formControlName="mode" [class.invalid]="isInvalid('mode')">
        <option value="">-- select --</option>
        <option *ngFor="let o of modeOpts" [value]="o">{{o}}</option>
      </select>
    </div>
  </div>

  <div class="error" *ngIf="error">{{ error }}</div>

  <div class="actions">
    <button type="button" class="btn" (click)="cancelled.emit()">Cancel</button>
    <button type="submit" class="btn btn-primary" [disabled]="saving">
      {{ saving ? 'Saving...' : 'Save' }}
    </button>
  </div>
</form>




